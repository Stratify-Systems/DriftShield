# AWS SES Email Settings
DRIFTSHIELD_SES_ENABLED=false
DRIFTSHIELD_SES_REGION=us-east-1
DRIFTSHIELD_SES_SENDER=sender@example.com
DRIFTSHIELD_SES_RECIPIENT=recipient@example.com

# AWS SNS Settings
DRIFTSHIELD_SNS_ENABLED=false
DRIFTSHIELD_SNS_REGION=us-east-1
DRIFTSHIELD_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:driftshield-alerts

# Slack Webhook Settings
DRIFTSHIELD_SLACK_ENABLED=false
DRIFTSHIELD_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# AI Settings (Groq API)
GROQ_API_KEY=your-groq-api-key-here

# Remote State Backend (S3)
DRIFTSHIELD_STATE_BUCKET=
DRIFTSHIELD_STATE_BUCKET_REGION=
